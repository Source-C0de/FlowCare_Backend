# Database - Use 'localhost' for local dev, 'postgres-db' for Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowcare_db
DB_USER=postgres
DB_PASSWORD=postgres

# Role IDs (Matches default seed)
ADMIN=1
BRANCH_MANAGER=2
STAFF=3
CUSTOMER=4

# JWT Security
JWT_SECRET_KEY=generate_a_secure_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Registration
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=Admin@123

# File Storage (MinIO) - Use 'localhost' for local, 'minio' for Docker
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=flowcare
MINIO_REGION=us-east-1
MINIO_SECURE=False

# Logging
LOG_LEVEL=INFO
DEBUG=True
